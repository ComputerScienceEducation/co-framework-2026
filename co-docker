#!/bin/bash
# Script used to build and run a target from the current directory
# Runs the target in a Docker container x86_64 Ubuntu 24.04

IMAGE_NAME="ghcr.io/tcvdh/co-lab:2027"

create_docker() {
	if ! docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
		echo "Pulling $IMAGE_NAME..."
		docker pull --platform linux/amd64 "$IMAGE_NAME" && return 0
		echo "Pull failed. Building the image locally..."
		docker buildx build --platform linux/amd64 -t "$IMAGE_NAME" . || return 1
	fi
	return 0
}

main() {
	[ -z "$1" ] && {
		echo "Usage: $0 <target> [args...]"
		exit 1
	}

	create_docker || {
		echo "Failed to create docker image"
		exit 1
	}

	local mounts=(
		-v "$PWD/CMakeLists.txt:/co-lab/CMakeLists.txt:ro"
		-v "$PWD/.cmake:/co-lab/.cmake:ro"
		-v "$PWD/build-run:/co-lab/build-run:ro"
	)
	local d
	for d in "$PWD"/a[0-9]*/; do
		d=${d%/}
		mounts+=(-v "$d:/co-lab/$(basename "$d")")
	done

	docker run --platform linux/amd64 --rm \
		"${mounts[@]}" \
		-i $IMAGE_NAME \
		"$(basename "$1")" "${@:2}"
}

main "$@"
