#!/bin/bash
# Script used to build and run a target from the current directory
# Usage: ./build-run <target> [args...]

build() {
	local err out
	err=$(mktemp)
	out=$(mktemp)
	if [ ! -f .build/CMakeCache.txt ]; then
		cmake -S . -B .build 1>/dev/null 2>"$err" || {
			echo "Failed to configure project"
			cat "$err"
			rm -f "$err" "$out"
			return 1
		}
	fi
	cmake --build .build -t "$1" 1>"$out" 2>"$err" || {
		echo "Failed to build target"
		cat "$err"
		rm -f "$err" "$out"
		return 1
	}
	[ -x "./$1" ] || cat "$out"
	rm -f "$err" "$out"
	return 0
}

[ -z "$1" ] && echo "Usage: $0 <target> [args...]" && exit 1
case "$(uname -s)-$(uname -m)" in
Linux-aarch64 | Linux-arm*) exec ./co-docker "$@" ;;
esac

build "$1" || exit 1
[ -x "./$1" ] || exit 0
./"$1" "${@:2}"
